<launch>

    <!-- ====================================================== -->
    <!-- Safety                                                 -->
    <!-- ====================================================== -->

    <arg
        name="allow_arming_service"
        default="false" />


    <!-- ====================================================== -->
    <!-- Shared planning-frame origins                          -->
    <!--                                                       -->
    <!-- planning_world origin:                                 -->
    <!-- Competition Course ENU (16.0, 0.0, 0.0)               -->
    <!--                                                       -->
    <!-- Therefore these values are each UAV local origin       -->
    <!-- expressed in planning_world.                           -->
    <!-- ====================================================== -->

    <arg
        name="uav1_origin_x"
        default="0.0" />

    <arg
        name="uav1_origin_y"
        default="-0.7" />

    <arg
        name="uav1_origin_z"
        default="0.0" />

    <arg
        name="uav1_origin_yaw_deg"
        default="0.0" />


    <arg
        name="uav2_origin_x"
        default="0.0" />

    <arg
        name="uav2_origin_y"
        default="0.7" />

    <arg
        name="uav2_origin_z"
        default="0.0" />

    <arg
        name="uav2_origin_yaw_deg"
        default="0.0" />


    <!-- ====================================================== -->
    <!-- Tunnel-entry sequencing                                -->
    <!--                                                       -->
    <!-- Release UAV2 after UAV1 has travelled this far in      -->
    <!-- planning_world +X.                                     -->
    <!--                                                       -->
    <!-- Section A begins near x = 2.5 in planning_world.       -->
    <!-- x = 4.0 therefore means UAV1 is already inside.        -->
    <!-- ====================================================== -->

    <arg
        name="entry_release_x"
        default="4.0" />


    <!-- ====================================================== -->
    <!-- UAV1                                                   -->
    <!-- EGO planning_world -> PX4 local setpoint               -->
    <!-- ====================================================== -->

    <group ns="uav1">

        <node
            pkg="future_aircraft_mission"
            type="ego_setpoint_bridge_node"
            name="ego_setpoint_bridge"
            output="screen">

            <!--
                EGO traj_server output.
                PositionCommand is expressed in planning_world.
            -->
            <param
                name="planner_topic"
                value="planning/pos_cmd" />


            <!--
                Listen to the upstream UAV-local mission goal.

                The bridge uses this only as the trajectory-generation
                handoff barrier. SharedFrameAdapter separately converts
                the same goal into planning_world for EGO.
            -->
            <param
                name="goal_topic"
                value="planning/goal_local" />


            <!-- PX4 / MAVROS local setpoint -->
            <param
                name="setpoint_topic"
                value="mavros/setpoint_raw/local" />


            <!-- Shared-world -> UAV1-local inverse transform -->
            <param
                name="shared_frame/enabled"
                value="true" />

            <param
                name="shared_frame/origin_x"
                value="$(arg uav1_origin_x)" />

            <param
                name="shared_frame/origin_y"
                value="$(arg uav1_origin_y)" />

            <param
                name="shared_frame/origin_z"
                value="$(arg uav1_origin_z)" />

            <param
                name="shared_frame/origin_yaw_deg"
                value="$(arg uav1_origin_yaw_deg)" />

        </node>

    </group>


    <!-- ====================================================== -->
    <!-- UAV2                                                   -->
    <!-- ====================================================== -->

    <group ns="uav2">

        <node
            pkg="future_aircraft_mission"
            type="ego_setpoint_bridge_node"
            name="ego_setpoint_bridge"
            output="screen">

            <param
                name="planner_topic"
                value="planning/pos_cmd" />

            <param
                name="goal_topic"
                value="planning/goal_local" />

            <param
                name="setpoint_topic"
                value="mavros/setpoint_raw/local" />


            <!-- Shared-world -> UAV2-local inverse transform -->
            <param
                name="shared_frame/enabled"
                value="true" />

            <param
                name="shared_frame/origin_x"
                value="$(arg uav2_origin_x)" />

            <param
                name="shared_frame/origin_y"
                value="$(arg uav2_origin_y)" />

            <param
                name="shared_frame/origin_z"
                value="$(arg uav2_origin_z)" />

            <param
                name="shared_frame/origin_yaw_deg"
                value="$(arg uav2_origin_yaw_deg)" />

        </node>

    </group>


    <!-- ====================================================== -->
    <!-- MissionManager                                         -->
    <!--                                                       -->
    <!-- Responsibilities:                                      -->
    <!--   takeoff                                              -->
    <!--   UAV1-first tunnel entry                              -->
    <!--   sparse RoutePoint progression                        -->
    <!--   fly-through retarget                                 -->
    <!--   final landing-area navigation                        -->
    <!--   AUTO.LAND                                            -->
    <!--                                                       -->
    <!-- EGO-Swarm still owns local trajectory planning and     -->
    <!-- inter-UAV collision avoidance.                         -->
    <!-- ====================================================== -->

    <node
        pkg="future_aircraft_mission"
        type="future_aircraft_mission_node"
        name="future_aircraft_mission"
        output="screen">


        <!-- ================================================== -->
        <!-- Mission mode                                       -->
        <!-- ================================================== -->

        <param
            name="smoke_test"
            value="false" />


        <!-- ================================================== -->
        <!-- UAV1 VehicleInterface / EgoInterface                -->
        <!-- ================================================== -->

        <param
            name="uav1/allow_arming_service"
            value="$(arg allow_arming_service)" />

        <!--
            MissionManager publishes UAV-local navigation goals.
            SharedFrameAdapter converts them into planning_world.
        -->
        <param
            name="uav1/goal_topic"
            value="planning/goal_local" />

        <param
            name="uav1/planner_command_topic"
            value="planning/pos_cmd" />


        <!-- ================================================== -->
        <!-- UAV2 VehicleInterface / EgoInterface                -->
        <!-- ================================================== -->

        <param
            name="uav2/allow_arming_service"
            value="$(arg allow_arming_service)" />

        <param
            name="uav2/goal_topic"
            value="planning/goal_local" />

        <param
            name="uav2/planner_command_topic"
            value="planning/pos_cmd" />


        <!-- ================================================== -->
        <!-- Mission shared-frame contract                      -->
        <!--                                                       -->
        <!-- Must remain identical to the transforms used by    -->
        <!-- SharedFrameAdapter and EgoSetpointBridge.           -->
        <!-- ================================================== -->

        <param
            name="uav1_origin_x"
            value="$(arg uav1_origin_x)" />

        <param
            name="uav1_origin_y"
            value="$(arg uav1_origin_y)" />

        <param
            name="uav1_origin_z"
            value="$(arg uav1_origin_z)" />

        <param
            name="uav1_origin_yaw_deg"
            value="$(arg uav1_origin_yaw_deg)" />


        <param
            name="uav2_origin_x"
            value="$(arg uav2_origin_x)" />

        <param
            name="uav2_origin_y"
            value="$(arg uav2_origin_y)" />

        <param
            name="uav2_origin_z"
            value="$(arg uav2_origin_z)" />

        <param
            name="uav2_origin_yaw_deg"
            value="$(arg uav2_origin_yaw_deg)" />


        <!-- ================================================== -->
        <!-- Tunnel entry                                       -->
        <!-- ================================================== -->

        <param
            name="entry_release_x"
            value="$(arg entry_release_x)" />

    </node>

</launch>