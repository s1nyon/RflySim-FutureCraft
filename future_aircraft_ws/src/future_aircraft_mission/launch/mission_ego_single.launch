<launch>
    <arg name="allow_arming_service" default="false" />

    <arg name="_uav1_goal_x" default="1.0" />
    <arg name="_uav1_goal_y" default="0.0" />
    <arg name="_uav1_goal_z" default="1.0" />

    <arg name="_uav2_goal_x" default="1.0" />
    <arg name="_uav2_goal_y" default="0.0" />
    <arg name="_uav2_goal_z" default="1.0" />

    <!-- EGO PositionCommand -> MAVROS setpoint -->
    <group ns="uav1">
        <node
            pkg="future_aircraft_mission"
            type="ego_setpoint_bridge_node"
            name="ego_setpoint_bridge"
            output="screen"/>
    </group>


    <!-- C++ Mission -->
    <node
        pkg="future_aircraft_mission"
        type="future_aircraft_mission_node"
        name="future_aircraft_mission"
        output="screen">

        <param name="smoke_test" value="false" />

        <param
            name="uav1/allow_arming_service"
            value="$(arg allow_arming_service)" />

        <param name="uav1/goal_x" value="$(arg _uav1_goal_x)" />
        <param name="uav1/goal_y" value="$(arg _uav1_goal_y)" />
        <param name="uav1/goal_z" value="$(arg _uav1_goal_z)" />

        <param name="uav2/goal_x" value="$(arg _uav2_goal_x)" />
        <param name="uav2/goal_y" value="$(arg _uav2_goal_y)" />
        <param name="uav2/goal_z" value="$(arg _uav2_goal_z)" />

    </node>
</launch>