<launch>
  <arg name="drone_id" default="0"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>
  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="camera_pose_topic" default="/unused_camera_pose"/>
  <arg name="depth_topic" default="/uav1/rflysim/sensor3/img_depth"/>
  <arg name="pos_cmd_topic" default="/planning/pos_cmd"/>
  <arg name="goal_topic" default="/move_base_simple/goal"/>
  <arg name="map_size_x" default="12.0"/>
  <arg name="map_size_y" default="8.0"/>
  <arg name="map_size_z" default="2.0"/>
  <arg name="max_vel" default="0.3"/>
  <arg name="max_acc" default="0.5"/>
  <arg name="planning_horizon" default="2.5"/>
  <arg name="flight_type" default="1"/>

  <!-- These global world/map/base_link/camera_link static frames are intentionally
       omitted: they would pollute the TF tree and cannot connect to the per-UAV
       uavX_map/uavX_odom frames used by the MAVROS odometry plugin. -->

  <node pkg="ego_planner" name="rflysim_ego_swarm_node" type="ego_planner_node" output="screen">
    <remap from="/move_base_simple/goal" to="$(arg goal_topic)"/>
    <remap from="~odom_world" to="$(arg odom_topic)"/>
    <remap from="~planning/bspline" to="/drone_$(arg drone_id)_planning/bspline"/>
    <remap from="~planning/data_display" to="/drone_$(arg drone_id)_planning/data_display"/>
    <remap from="~planning/broadcast_bspline_from_planner" to="/broadcast_bspline"/>
    <remap from="~planning/broadcast_bspline_to_planner" to="/broadcast_bspline"/>
    <remap from="~grid_map/odom" to="$(arg odom_topic)"/>
    <remap from="~grid_map/cloud" to="$(arg cloud_topic)"/>
    <remap from="~grid_map/pose" to="$(arg camera_pose_topic)"/>
    <remap from="~grid_map/depth" to="$(arg depth_topic)"/>

    <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
    <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
    <param name="fsm/thresh_no_replan_meter" value="1.0" type="double"/>
    <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <param name="fsm/planning_horizen_time" value="3.0" type="double"/>
    <param name="fsm/emergency_time" value="1.0" type="double"/>
    <param name="fsm/realworld_experiment" value="false" type="bool"/>
    <param name="fsm/fail_safe" value="true" type="bool"/>

    <param name="fsm/waypoint_num" value="1" type="int"/>
    <param name="fsm/waypoint0_x" value="0.0" type="double"/>
    <param name="fsm/waypoint0_y" value="0.0" type="double"/>
    <param name="fsm/waypoint0_z" value="1.0" type="double"/>
    <param name="fsm/waypoint1_x" value="0.0" type="double"/>
    <param name="fsm/waypoint1_y" value="0.0" type="double"/>
    <param name="fsm/waypoint1_z" value="1.0" type="double"/>
    <param name="fsm/waypoint2_x" value="0.0" type="double"/>
    <param name="fsm/waypoint2_y" value="0.0" type="double"/>
    <param name="fsm/waypoint2_z" value="1.0" type="double"/>
    <param name="fsm/waypoint3_x" value="0.0" type="double"/>
    <param name="fsm/waypoint3_y" value="0.0" type="double"/>
    <param name="fsm/waypoint3_z" value="1.0" type="double"/>
    <param name="fsm/waypoint4_x" value="0.0" type="double"/>
    <param name="fsm/waypoint4_y" value="0.0" type="double"/>
    <param name="fsm/waypoint4_z" value="1.0" type="double"/>

    <param name="grid_map/resolution" value="0.05"/>
    <param name="grid_map/map_size_x" value="$(arg map_size_x)"/>
    <param name="grid_map/map_size_y" value="$(arg map_size_y)"/>
    <param name="grid_map/map_size_z" value="$(arg map_size_z)"/>
    <param name="grid_map/local_update_range_x" value="10.0"/>
    <param name="grid_map/local_update_range_y" value="10.0"/>
    <param name="grid_map/local_update_range_z" value="2.0"/>
    <param name="grid_map/obstacles_inflation" value="0.25"/>
    <param name="grid_map/local_map_margin" value="5"/>
    <param name="grid_map/ground_height" value="-0.5"/>
    <param name="grid_map/cx" value="320.0"/>
    <param name="grid_map/cy" value="240.0"/>
    <param name="grid_map/fx" value="320.0"/>
    <param name="grid_map/fy" value="320.0"/>
    <param name="grid_map/use_depth_filter" value="true"/>
    <param name="grid_map/depth_filter_tolerance" value="0.1"/>
    <param name="grid_map/depth_filter_maxdist" value="5.0"/>
    <param name="grid_map/depth_filter_mindist" value="0.2"/>
    <param name="grid_map/depth_filter_margin" value="2"/>
    <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
    <param name="grid_map/skip_pixel" value="2"/>
    <param name="grid_map/p_hit" value="0.60"/>
    <param name="grid_map/p_miss" value="0.40"/>
    <param name="grid_map/p_min" value="0.12"/>
    <param name="grid_map/p_max" value="0.90"/>
    <param name="grid_map/p_occ" value="0.85"/>
    <param name="grid_map/min_ray_length" value="0.2"/>
    <param name="grid_map/max_ray_length" value="3.5"/>
    <param name="grid_map/virtual_ceil_height" value="2.0"/>
    <param name="grid_map/visualization_truncate_height" value="1.99"/>
    <param name="grid_map/show_occ_time" value="false"/>
    <param name="grid_map/pose_type" value="2"/>
    <param name="grid_map/frame_id" value="world"/>

    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="manager/max_jerk" value="4.0" type="double"/>
    <param name="manager/control_points_distance" value="0.1" type="double"/>
    <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
    <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
    <param name="manager/use_distinctive_trajs" value="false" type="bool"/>
    <param name="manager/drone_id" value="$(arg drone_id)" type="int"/>

    <param name="optimization/lambda_smooth" value="1.0" type="double"/>
    <param name="optimization/lambda_collision" value="5.0" type="double"/>
    <param name="optimization/lambda_feasibility" value="0.1" type="double"/>
    <param name="optimization/lambda_fitness" value="1.0" type="double"/>
    <param name="optimization/dist0" value="0.1" type="double"/>
    <param name="optimization/swarm_clearance" value="0.5" type="double"/>
    <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>

    <param name="bspline/limit_vel" value="$(arg max_vel)" type="double"/>
    <param name="bspline/limit_acc" value="$(arg max_acc)" type="double"/>
    <param name="bspline/limit_ratio" value="1.1" type="double"/>

    <param name="prediction/obj_num" value="0" type="int"/>
    <param name="prediction/lambda" value="1.0" type="double"/>
    <param name="prediction/predict_rate" value="1.0" type="double"/>
  </node>

  <node pkg="ego_planner" name="rflysim_traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="$(arg pos_cmd_topic)"/>
    <remap from="~planning/bspline" to="/drone_$(arg drone_id)_planning/bspline"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
  </node>
</launch>
