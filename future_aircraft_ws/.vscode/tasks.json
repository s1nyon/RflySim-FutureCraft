{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: future_aircraft_ws",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "${workspaceFolder}/../scripts/wsl/build_future_aircraft_ws.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "sim: doctor",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../sim.ps1",
        "doctor"
      ],
      "problemMatcher": []
    },
    {
      "label": "sim: start (dry-run)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../sim.ps1",
        "start"
      ],
      "problemMatcher": []
    },
    {
      "label": "sim: status",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../sim.ps1",
        "status"
      ],
      "problemMatcher": []
    },
    {
      "label": "sim: stop (dry-run)",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../sim.ps1",
        "stop"
      ],
      "problemMatcher": []
    },
    {
      "label": "validate: core",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/../sim.ps1",
        "validate",
        "-Suite",
        "core"
      ],
      "problemMatcher": []
    }
  ]
}
