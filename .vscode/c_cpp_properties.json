{
  "version": 4,
  "configurations": [
    {
      "name": "ROS-Noetic-WSL",
      "compilerPath": "/usr/bin/g++",
      "intelliSenseMode": "linux-gcc-x64",
      "cppStandard": "c++17",
      "compileCommands": "${workspaceFolder}/future_aircraft_ws/build/compile_commands.json",
      "includePath": [
        "${workspaceFolder}/future_aircraft_ws/src/**",
        "${workspaceFolder}/future_aircraft_ws/devel/include/**",
        "${workspaceFolder}/third_party/ego-planner-swarm/devel/include/**",
        "/opt/ros/noetic/include/**",
        "/opt/ros/noetic/share/**"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/future_aircraft_ws/src",
          "${workspaceFolder}/future_aircraft_ws/devel/include",
          "${workspaceFolder}/third_party/ego-planner-swarm/devel/include",
          "/opt/ros/noetic/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "defines": [
        "ROS_PACKAGE_NAME=\"multi_uav_mission\""
      ]
    }
  ]
}
